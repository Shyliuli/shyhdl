# Build output
/target/

# Generated artifacts: Verilog, metadata and waveforms are build results, not
# sources, and must not be committed. Recordings written by a run
# may also land outside build/ and out/, so the patterns are global.
/build/
/out/
*.vcd
*.fst
*.meta.json
*.manifest.json
obj_dir/
*.vvp

# Local toolchain checkout, if anyone unpacks one into the repository
/.tools/

# Local editor and shell noise
*.rs.bk
*.swp
